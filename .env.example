# Salin file ini menjadi .env lalu isi sesuai lingkungan Anda (laptop / VPS).
# File .env TIDAK boleh di-commit karena berisi password dan secret.

PORT=3000

# Untuk XAMPP/Laragon di laptop: DB_HOST=127.0.0.1, DB_USER=root, DB_PASSWORD=
# Untuk Docker Compose (lokal/VPS): DB_HOST otomatis memakai service "db" di dalam container.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lapakpindah
DB_PASSWORD=lapakpindah_dev
DB_ROOT_PASSWORD=ganti_password_root_mysql
DB_NAME=lapakpindah

# Kunci rahasia untuk token login. Di VPS WAJIB diganti dengan teks acak panjang
# (contoh generate: openssl rand -hex 32).
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
JWT_EXPIRES_IN=30d

# Folder penyimpanan foto nota (Modul 2).
UPLOAD_DIR=uploads

# ── Khusus Deploy VPS (Docker Compose + Caddy HTTPS) ──
# Isi dengan domain Anda (misal: api.lapakpindah.my.id) atau sslip.io
# (misal: 103.123.45.67.sslip.io) untuk HTTPS otomatis Let's Encrypt.
# Jika belum punya domain dan hanya ingin HTTP sementara, isi :80
DOMAIN=:80

# Alamat bind port API di host. Default 127.0.0.1 aman untuk VPS (akses lewat Caddy).
# Jika ingin akses langsung dari HP lewat Wi-Fi lokal tanpa Caddy, ubah ke 0.0.0.0
API_BIND_HOST=127.0.0.1

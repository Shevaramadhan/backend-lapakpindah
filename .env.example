# Salin file ini menjadi .env lalu isi sesuai MySQL Anda.
# File .env TIDAK boleh di-commit karena berisi password.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lapakpindah

# Kunci rahasia untuk token login. Di server online WAJIB diganti dengan
# teks acak yang panjang.
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
JWT_EXPIRES_IN=30d

# Folder penyimpanan foto nota (Modul 2).
UPLOAD_DIR=uploads
